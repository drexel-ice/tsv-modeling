/* Synthetic passive pad interface for SPEF parsing only; no timing arcs. */
library (synthetic_tsv_pads) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);
  nom_voltage : 1.0;
  nom_temperature : 25.0;
  nom_process : 1.0;
  cell (TSV_LANDING) {
    area : 25.0;
    pin (PAD) { direction : inout; capacitance : 0.0; }
  }
}
