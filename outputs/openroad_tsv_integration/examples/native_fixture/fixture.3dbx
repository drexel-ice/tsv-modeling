Header:
  version: "1.0"
  unit: micron
  precision: 2000
  include: [fixture.3dbv]
Design:
  name: synthetic_tsv_top
  external:
    verilog_file: top.v
ChipletInst:
  bottom_die:
    reference: bottom_chip
  top_die:
    reference: top_chip
Stack:
  bottom_die:
    loc: [0, 0]
    z: 0
    orient: R0
  top_die:
    loc: [0, 0]
    z: 120
    orient: R0
