new file mode 100644
index 0000000000..50ba29547f
--- /dev/null
+++ b/src/rcx/test/TestMultiChipSpef.cpp
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "rcx/ext_options.h"
+#include "rcx/multiChipSpefWriter.h"
+#include "src/odb/test/cpp/helper/helper.h"
+
+namespace rcx {
+namespace {
+
+class MultiChipSpefTest : public odb::SimpleDbFixture
+{
+ protected:
+  void SetUp() override
+  {
+    createSimpleDB();
+    top_ = odb::dbChip::create(
+        db_.get(), nullptr, "assembly", odb::dbChip::ChipType::HIER);
+    db_->setTopChip(top_);
+    auto* tech = odb::dbTech::create(db_.get(), "bond_tech");
+    auto* lib = odb::dbLib::create(db_.get(), "pads", tech, '/');
+    auto* layer = odb::dbTechLayer::create(
+        tech, "pad_layer", odb::dbTechLayerType::MASTERSLICE);
+    auto* master = createMaster1X1(lib, "pad", 100, 100, "in", "out");
+    std::vector<odb::dbChipInst*> placements;
+    std::vector<odb::dbChipRegion*> regions;
+    for (const std::string name : {"a", "b"}) {
+      auto* die = odb::dbChip::create(db_.get(), tech, name);
+      auto* block = odb::dbBlock::create(die, name.c_str());
+      auto* region = odb::dbChipRegion::create(
+          die, "front", odb::dbChipRegion::Side::FRONT, layer);
+      for (const std::string pad_name : {"p0", "p1"}) {
+        auto* inst = odb::dbInst::create(block, master, pad_name.c_str());
+        auto* net = odb::dbNet::create(block, pad_name.c_str());
+        inst->findITerm("in")->connect(net);
+        auto* bump = odb::dbChipBump::create(region, inst);
+        bump->setNet(net);
+        bump->setBTerm(odb::dbBTerm::create(net, pad_name.c_str()));
+      }
+      regions.push_back(region);
+      placements.push_back(odb::dbChipInst::create(top_, die, name));
+    }
+    for (const std::string pad_name : {"p0", "p1"}) {
+      auto* net = odb::dbChipNet::create(top_, pad_name);
+      std::vector<odb::dbChipCapNode*> nodes;
+      for (size_t i = 0; i < placements.size(); ++i) {
+        auto* region = placements[i]->findChipRegionInst(regions[i]);
+        for (auto* bump : region->getChipBumpInsts()) {
+          if (bump->getChipBump()->getInst()->getName() == pad_name) {
+            net->addBumpInst(bump, {placements[i]});
+            auto* node = odb::dbChipCapNode::create(net);
+            node->setChipBumpInst(bump);
+            node->setCapacitance(1.0F);
+            nodes.push_back(node);
+          }
+        }
+      }
+      ASSERT_EQ(nodes.size(), 2);
+      odb::dbChipRSeg::create(net, nodes[0], nodes[1])->setResistance(1.0F);
+      nodes_.push_back(nodes);
+    }
+    for (int i = 0; i < 2; ++i) {
+      odb::dbChipCCSeg::create(nodes_[0][i], nodes_[1][i])
+          ->setCapacitance(0.5F);
+    }
+  }
+
+  void checkExport(const char* cap_unit,
+                   const char* res_unit,
+                   const double cap_scale,
+                   const double res_scale,
+                   const int expected_resistance_count = 2)
+  {
+    const auto base = std::filesystem::path(::testing::TempDir())
+                      / (std::string("chip_caps_") + cap_unit);
+    const std::string filename = base.string() + ".spef";
+    SpefOptions options;
+    options.file = filename.c_str();
+    options.cap_units = cap_unit;
+    options.res_units = res_unit;
+    options.assembly_only = true;
+    MultiChipSpefWriter writer(db_.get(), getLogger(), "IEEE 1481-1998");
+    writer.run(options);
+    std::ifstream input(base.string() + ".bonds.spef");
+    ASSERT_TRUE(input.is_open());
+    std::string line;
+    std::string section;
+    int net_count = 0;
+    int ground_count = 0;
+    int coupling_count = 0;
+    int resistance_count = 0;
+    while (std::getline(input, line)) {
+      std::istringstream record(line);
+      std::vector<std::string> fields;
+      for (std::string field; record >> field;) {
+        fields.push_back(field);
+      }
+      if (fields.empty()) {
+        continue;
+      }
+      if (fields[0] == "*D_NET") {
+        EXPECT_NEAR(std::stod(fields[2]), 3.0 * cap_scale, 1e-9);
+        ++net_count;
+      }
+      if (fields[0][0] == '*') {
+        section = fields[0];
+        continue;
+      }
+      if (section == "*CAP") {
+        if (fields.size() == 3) {
+          EXPECT_NEAR(std::stod(fields[2]), cap_scale, 1e-9);
+          ++ground_count;
+        } else {
+          ASSERT_EQ(fields.size(), 4);
+          EXPECT_NE(fields[1], fields[2]);
+          EXPECT_NEAR(std::stod(fields[3]), 0.5 * cap_scale, 1e-9);
+          ++coupling_count;
+        }
+      }
+      if (section == "*RES") {
+        ASSERT_EQ(fields.size(), 4);
+        EXPECT_NEAR(std::stod(fields[3]), res_scale, 1e-9);
+        ++resistance_count;
+      }
+    }
+    EXPECT_EQ(net_count, 2);
+    EXPECT_EQ(ground_count, 4);
+    EXPECT_EQ(coupling_count, 4);  // Both nets list their incident pair.
+    EXPECT_EQ(resistance_count, expected_resistance_count);
+  }
+
+  odb::dbChip* top_{nullptr};
+  std::vector<std::vector<odb::dbChipCapNode*>> nodes_;
+};
+
+TEST_F(MultiChipSpefTest, exports_ground_and_coupling_in_picofarads)
+{
+  checkExport("PF", "OHM", 0.001, 1.0);
+}
+
+TEST_F(MultiChipSpefTest, exports_femtofarads_and_kilohms)
+{
+  checkExport("FF", "KOHM", 1.0, 0.001);
+}
+
+TEST_F(MultiChipSpefTest, exports_capacitance_only_networks)
+{
+  auto segments = top_->getChipRSegs();
+  while (!segments.empty()) {
+    odb::dbChipRSeg::destroy(*segments.begin());
+  }
+  checkExport("FF", "OHM", 1.0, 1.0, 0);
+}
+
+TEST_F(MultiChipSpefTest, rejects_capacitance_only_node_without_bump)
+{
+  auto* const net = odb::dbChipNet::create(top_, "unbound");
+  auto* const node = odb::dbChipCapNode::create(net);
+  node->setCapacitance(1.0F);
+  ASSERT_EQ(node->getChipBumpInst(), nullptr);
+  ASSERT_TRUE(net->getChipRSegs().empty());
+
+  const std::string filename
+      = (std::filesystem::path(::testing::TempDir()) / "unbound_cap.spef")
+            .string();
+  SpefOptions options;
+  options.file = filename.c_str();
+  options.assembly_only = true;
+  MultiChipSpefWriter writer(db_.get(), getLogger(), "IEEE 1481-1998");
+  try {
+    writer.run(options);
+    FAIL() << "An unbound capacitor must not be silently omitted.";
+  } catch (const std::runtime_error& error) {
+    EXPECT_STREQ(error.what(), "RCX-6102");
+  }
+  EXPECT_FLOAT_EQ(node->getCapacitance(), 1.0F);
+}
+
+}  // namespace
+}  // namespace rcx
