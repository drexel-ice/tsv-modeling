+TEST_F(SimpleDbFixture, chip_coupling_validates_endpoints_and_values)
+{
+  createSimpleDB();
+  dbChip* chip = db_->getChip();
+  dbChipNet* left = dbChipNet::create(chip, "left");
+  dbChipNet* right = dbChipNet::create(chip, "right");
+  dbChipCapNode* source = dbChipCapNode::create(left);
+  dbChipCapNode* target = dbChipCapNode::create(right);
+  dbChipCCSeg* coupling = dbChipCCSeg::create(source, target);
+  coupling->setCapacitance(3.5F);
+  EXPECT_FLOAT_EQ(coupling->getCapacitance(), 3.5F);
+  EXPECT_EQ(coupling->getSourceCapNode(), source);
+  EXPECT_EQ(coupling->getTargetCapNode(), target);
+  EXPECT_EQ(coupling->getChip(), chip);
+  EXPECT_STREQ(coupling->getTypeName(), "dbChipCCSeg");
+  EXPECT_EQ(chip->getChipCCSegs().size(), 1);
+  EXPECT_EQ(dbChipCCSeg::create(nullptr, target), nullptr);
+  EXPECT_THROW(dbChipCCSeg::create(target, source), std::exception);
+  EXPECT_THROW(dbChipCCSeg::create(source, source), std::exception);
+  EXPECT_THROW(coupling->setCapacitance(-1.0F), std::exception);
+  EXPECT_THROW(coupling->setCapacitance(std::numeric_limits<float>::infinity()),
+               std::exception);
+  EXPECT_THROW(
+      coupling->setCapacitance(std::numeric_limits<float>::quiet_NaN()),
+      std::exception);
+  EXPECT_FLOAT_EQ(coupling->getCapacitance(), 3.5F);
+  dbChip* other = dbChip::create(db_.get(), chip->getTech(), "other");
+  dbChipCapNode* foreign
+      = dbChipCapNode::create(dbChipNet::create(other, "foreign"));
+  EXPECT_THROW(dbChipCCSeg::create(source, foreign), std::exception);
+}
+
+TEST_F(SimpleDbFixture, chip_coupling_is_removed_with_either_endpoint)
+{
+  createSimpleDB();
+  dbChip* chip = db_->getChip();
+  dbChipNet* left = dbChipNet::create(chip, "left");
+  dbChipNet* right = dbChipNet::create(chip, "right");
+  dbChipCapNode* source = dbChipCapNode::create(left);
+  dbChipCapNode* target = dbChipCapNode::create(right);
+  dbChipCCSeg* coupling = dbChipCCSeg::create(source, target);
+  dbStringProperty::create(coupling, "owner", "test");
+  dbChipCapNode::destroy(target);
+  EXPECT_EQ(chip->getChipCCSegs().size(), 0);
+  target = dbChipCapNode::create(right);
+  dbChipCCSeg::create(source, target);
+  dbChipNet::destroy(left);
+  EXPECT_EQ(chip->getChipCCSegs().size(), 0);
+  EXPECT_EQ(right->getChipCapNodes().size(), 1);
+}
+
+TEST_F(SimpleDbFixture, chip_coupling_survives_database_roundtrip)
+{
+  createSimpleDB();
+  dbChip* chip = db_->getChip();
+  dbChipCapNode* source
+      = dbChipCapNode::create(dbChipNet::create(chip, "left"));
+  dbChipCapNode* target
+      = dbChipCapNode::create(dbChipNet::create(chip, "right"));
+  dbChipCCSeg* coupling = dbChipCCSeg::create(source, target);
+  coupling->setCapacitance(5.25F);
+  dbStringProperty::create(coupling, "owner", "test");
+  std::stringstream stream(std::ios::in | std::ios::out | std::ios::binary);
+  db_->write(stream);
+  stream.seekg(0);
+  std::unique_ptr<dbDatabase, decltype(&dbDatabase::destroy)> restored(
+      dbDatabase::create(), dbDatabase::destroy);
+  restored->read(stream);
+  dbChip* chip2 = restored->getChip();
+  ASSERT_EQ(chip2->getChipCCSegs().size(), 1);
+  dbChipCCSeg* copy = *chip2->getChipCCSegs().begin();
+  EXPECT_FLOAT_EQ(copy->getCapacitance(), 5.25F);
+  EXPECT_EQ(copy->getSourceCapNode()->getChipNet(), chip2->findChipNet("left"));
+  EXPECT_EQ(copy->getTargetCapNode()->getChipNet(),
+            chip2->findChipNet("right"));
+  ASSERT_NE(dbStringProperty::find(copy, "owner"), nullptr);
+  EXPECT_EQ(dbStringProperty::find(copy, "owner")->getValue(), "test");
+  EXPECT_EQ(dbStringProperty::find(copy, "owner")->getPropOwner(), copy);
+}
+
+TEST_F(SimpleDbFixture, reads_schema_141_chip_net_property_owner)
+{
+  const std::string file
+      = tst::getRunfilePath("_main/src/odb/test/data/chip_property_v141.odb");
+  std::ifstream input(file, std::ios::binary);
+  ASSERT_TRUE(input.is_open());
+  db_->read(input);
+  dbChipNet* net = db_->getChip()->findChipNet("legacy_net");
+  ASSERT_NE(net, nullptr);
+  dbStringProperty* property = dbStringProperty::find(net, "owner");
+  ASSERT_NE(property, nullptr);
+  EXPECT_EQ(property->getValue(), "legacy_schema_141");
+  EXPECT_EQ(property->getPropOwner(), net);
+  EXPECT_EQ(db_->getChip()->getChipCCSegs().size(), 0);
+}
