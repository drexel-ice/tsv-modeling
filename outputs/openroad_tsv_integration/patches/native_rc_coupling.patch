+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+// Generator Code Begin Cpp
+#include "dbChipCCSeg.h"
+
+#include <cmath>
+
+#include "dbChip.h"
+#include "dbChipCapNode.h"
+#include "dbChipNet.h"
+#include "dbCore.h"
+#include "dbDatabase.h"
+#include "dbTable.h"
+#include "odb/db.h"
+#include "utl/Logger.h"
+namespace odb {
+template class dbTable<_dbChipCCSeg>;
+
+bool _dbChipCCSeg::operator==(const _dbChipCCSeg& rhs) const
+{
+  // NOLINTBEGIN(readability-simplify-boolean-expr)
+  if (source_cap_node_ != rhs.source_cap_node_) {
+    return false;
+  }
+  if (target_cap_node_ != rhs.target_cap_node_) {
+    return false;
+  }
+  if (capacitance_ != rhs.capacitance_) {
+    return false;
+  }
+
+  return true;
+  // NOLINTEND(readability-simplify-boolean-expr)
+}
+
+bool _dbChipCCSeg::operator<(const _dbChipCCSeg& rhs) const
+{
+  return true;
+}
+
+_dbChipCCSeg::_dbChipCCSeg(_dbDatabase* db)
+{
+  capacitance_ = 0.0;
+}
+
+dbIStream& operator>>(dbIStream& stream, _dbChipCCSeg& obj)
+{
+  stream >> obj.source_cap_node_;
+  stream >> obj.target_cap_node_;
+  stream >> obj.capacitance_;
+  return stream;
+}
+
+dbOStream& operator<<(dbOStream& stream, const _dbChipCCSeg& obj)
+{
+  stream << obj.source_cap_node_;
+  stream << obj.target_cap_node_;
+  stream << obj.capacitance_;
+  return stream;
+}
+
+void _dbChipCCSeg::collectMemInfo(MemInfo& info)
+{
+  info.cnt++;
+  info.size += sizeof(*this);
+}
+
+////////////////////////////////////////////////////////////////////
+//
+// dbChipCCSeg - Methods
+//
+////////////////////////////////////////////////////////////////////
+
+// User Code Begin dbChipCCSegPublicMethods
+float dbChipCCSeg::getCapacitance() const
+{
+  return reinterpret_cast<const _dbChipCCSeg*>(this)->capacitance_;
+}
+
+void dbChipCCSeg::setCapacitance(const float capacitance)
+{
+  if (!std::isfinite(capacitance) || capacitance < 0.0F) {
+    (reinterpret_cast<_dbChip*>(getChip()))
+        ->getLogger()
+        ->error(utl::ODB,
+                6000,
+                "Chip coupling capacitance must be finite and nonnegative.");
+  }
+  (reinterpret_cast<_dbChipCCSeg*>(this))->capacitance_ = capacitance;
+}
+
+dbChip* dbChipCCSeg::getChip() const
+{
+  return reinterpret_cast<dbChip*>(
+      reinterpret_cast<const _dbChipCCSeg*>(this)->getOwner());
+}
+
+dbChipCapNode* dbChipCCSeg::getSourceCapNode() const
+{
+  const auto* obj = reinterpret_cast<const _dbChipCCSeg*>(this);
+  const auto* chip = reinterpret_cast<_dbChip*>(obj->getOwner());
+  return reinterpret_cast<dbChipCapNode*>(
+      chip->chip_cap_node_tbl_->getPtr(obj->source_cap_node_));
+}
+
+dbChipCapNode* dbChipCCSeg::getTargetCapNode() const
+{
+  const auto* obj = reinterpret_cast<const _dbChipCCSeg*>(this);
+  const auto* chip = reinterpret_cast<_dbChip*>(obj->getOwner());
+  return reinterpret_cast<dbChipCapNode*>(
+      chip->chip_cap_node_tbl_->getPtr(obj->target_cap_node_));
+}
+
+dbChipCCSeg* dbChipCCSeg::create(dbChipCapNode* source, dbChipCapNode* target)
+{
+  if (source == nullptr || target == nullptr) {
+    return nullptr;
+  }
+  dbChip* chip = source->getChipNet()->getChip();
+  auto* impl = reinterpret_cast<_dbChip*>(chip);
+  if (chip != target->getChipNet()->getChip()
+      || source->getChipNet() == target->getChipNet()) {
+    impl->getLogger()->error(
+        utl::ODB,
+        6001,
+        "Chip coupling endpoints must be on different nets of the same chip.");
+  }
+  for (dbChipCCSeg* existing : chip->getChipCCSegs()) {
+    if ((existing->getSourceCapNode() == source
+         && existing->getTargetCapNode() == target)
+        || (existing->getSourceCapNode() == target
+            && existing->getTargetCapNode() == source)) {
+      impl->getLogger()->error(
+          utl::ODB,
+          6002,
+          "A chip coupling capacitor already exists between these endpoints.");
+    }
+  }
+  auto* obj = impl->chip_cc_seg_tbl_->create();
+  obj->source_cap_node_ = source->getImpl()->getOID();
+  obj->target_cap_node_ = target->getImpl()->getOID();
+  return reinterpret_cast<dbChipCCSeg*>(obj);
+}
+
+void dbChipCCSeg::destroy(dbChipCCSeg* coupling)
+{
+  auto* obj = reinterpret_cast<_dbChipCCSeg*>(coupling);
+  auto* chip = reinterpret_cast<_dbChip*>(obj->getOwner());
+  dbProperty::destroyProperties(coupling);
+  chip->chip_cc_seg_tbl_->destroy(obj);
+}
+// User Code End dbChipCCSegPublicMethods
+}  // namespace odb
