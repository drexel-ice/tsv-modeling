diff --git a/src/dbSta/test/3dic_native_caps.tcl b/src/dbSta/test/3dic_native_caps.tcl
new file mode 100644
index 0000000000..2cb10b5dd4
--- /dev/null
+++ b/src/dbSta/test/3dic_native_caps.tcl
@@ -0,0 +1,53 @@
+# Verify native bond ground C reaches cross-die STA through exported SPEF.
+source "helpers.tcl"
+# Use fresh timing sessions: re-reading SPEF after timing has been evaluated
+# can retain a previously reduced parasitic network in the timing cache.
+if { ![info exists ::env(TSV_NATIVE_TEST_CAP_FF)] } {
+  set slacks {}
+  foreach cap {0 50} {
+    set ::env(TSV_NATIVE_TEST_CAP_FF) $cap
+    set output [exec [info nameofexecutable] -no_splash -no_init -exit -threads 1 [info script]]
+    puts $output
+    if { ![regexp {TSV_SLACK=([-+0-9.eE]+)} $output -> slack] } {
+      error "Missing fresh-session timing result"
+    }
+    lappend slacks $slack
+  }
+  unset ::env(TSV_NATIVE_TEST_CAP_FF)
+  lassign $slacks slack0 slack1
+  if { !($slack1 < $slack0 - 0.001) } {
+    error "Native capacitance did not increase cross-die delay: $slack0 -> $slack1"
+  }
+  puts "pass"
+  exit
+}
+read_3dbx 3dic_cross.3dbx
+create_clock -name clk -period 1.0 [get_pins -of_objects [get_nets clk_top]]
+set db [ord::get_db]
+set nodes {}
+foreach unet [$db getUnfoldedChipNets] {
+  set net [$unet getChipNet]
+  if { [$net getName] eq "bridge" } {
+    foreach bump [$unet getConnectedBumps] {
+      set node [odb::dbChipCapNode_create $net]
+      $node setChipBumpInst [$bump getChipBumpInst]
+      lappend nodes $node
+    }
+    odb::dbChipRSeg_create $net [lindex $nodes 0] [lindex $nodes 1]
+    [lindex [$net getChipRSegs] 0] setResistance 2000.0
+  }
+}
+if { [llength $nodes] != 2 } { error "Expected two bridge terminals" }
+proc stitched_slack { base } {
+  read_spef "[file rootname $base].bonds.spef"
+  read_spef -path chipA 3dic_spef.a.spef
+  read_spef -path chipB 3dic_spef.b.spef
+  set paths [find_timing_paths -path_delay max -group_path_count 1]
+  if { [llength $paths] != 1 } { error "Missing stitched timing path" }
+  return [get_property [lindex $paths 0] slack]
+}
+set cap $::env(TSV_NATIVE_TEST_CAP_FF)
+foreach node $nodes { $node setCapacitance $cap }
+set spef [make_result_file "native_c_${cap}.spef"]
+write_spef -assembly_only $spef
+puts "TSV_SLACK=[stitched_slack $spef]"
