+        self.assertEqual(actual[-1], "dbChipCCSegObj")
+        names = self.env.get_template("dbObject.cpp.jinja").render(schema=self.schema)
+        name_block = names.split("//Generator Code End ObjectNames")[0]
+        actual_names = [
+            line.strip().rstrip(",").strip('"')
+            for line in name_block.splitlines()
+            if line.strip().startswith('"')
+        ]
+        self.assertEqual(actual_names, legacy)
+        appended = names.split("//Generator Code Begin AppendedObjectNames")[1]
+        self.assertIn('"dbChipCCSeg",', appended)
+
