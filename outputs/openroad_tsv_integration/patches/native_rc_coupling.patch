+++ b/src/rcx/test/chip_caps_api.tcl
@@ -0,0 +1,43 @@
+# Smoke-test chip-level RC collections and assembly-only SPEF Tcl bindings.
+source "helpers.tcl"
+set db [ord::get_db]
+set chip [odb::dbChip_create $db NULL assembly HIER]
+$db setTopChip $chip
+set left [odb::dbChipNet_create $chip left]
+set right [odb::dbChipNet_create $chip right]
+set source [odb::dbChipCapNode_create $left]
+set mid [odb::dbChipCapNode_create $left]
+set target [odb::dbChipCapNode_create $right]
+set resistor [odb::dbChipRSeg_create $left $source $mid]
+$resistor setResistance 1.0
+set coupling [odb::dbChipCCSeg_create $source $target]
+$coupling setCapacitance 1.0
+if {
+  [llength [$chip getChipCCSegs]] != 1 || [llength [$left getChipRSegs]] != 1
+  || [llength [$chip getChipCapNodes]] != 3
+} {
+  error "Native RC collection binding failed"
+}
+odb::dbChipCCSeg_destroy $coupling
+odb::dbChipRSeg_destroy $resistor
+odb::dbChipCapNode_destroy $source
+odb::dbChipCapNode_destroy $mid
+odb::dbChipCapNode_destroy $target
+write_spef -assembly_only [make_result_file empty_assembly.spef]
+set unbound_net [odb::dbChipNet_create $chip unbound]
+set unbound_node [odb::dbChipCapNode_create $unbound_net]
+$unbound_node setCapacitance 1.0
+if {
+  ![catch {
+    write_spef -assembly_only [make_result_file unbound_cap.spef]
+  } message]
+} {
+  error "Expected rejection of a capacitor without a bump reference"
+}
+if { ![string match {*RCX-6102*} $message] } {
+  error "Unexpected unbound capacitor diagnostic: $message"
+}
+if { [$unbound_node getCapacitance] != 1.0 } {
+  error "Failed export changed the stored capacitance"
+}
+puts "pass"
