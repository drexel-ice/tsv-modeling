+    def test_new_chip_coupling_type_preserves_legacy_ordinals(self):
+        rendered = self.env.get_template("dbObject.h.jinja").render(schema=self.schema)
+        actual = [
+            line.strip().rstrip(",")
+            for line in rendered.splitlines()
+            if line.strip().endswith("Obj,")
+        ]
+        legacy = sorted(
+            (k.name for k in self.schema.classes if k.name != "dbChipCCSeg"),
+            key=str.lower,
+        )
